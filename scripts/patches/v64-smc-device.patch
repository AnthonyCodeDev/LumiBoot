diff --git a/src/smc.js b/src/smc.js
new file mode 100644
index 00000000..1816ce3f
--- /dev/null
+++ b/src/smc.js
@@ -0,0 +1,334 @@
+// For Types Only
+import { CPU } from "./cpu.js";
+
+/**
+ * The Apple SMC: the ISA chip QEMU emulates as isa-applesmc
+ * (hw/misc/applesmc.c), on the three single-byte ports macOS' AppleSMC.kext
+ * talks to. Lion's Dont_Steal_Mac_OS_X reads the OSK key from here, checks it
+ * against the one it carries, and publishes the DSMOS service once it matches;
+ * without an SMC the boot stops at "Waiting for DSMOS...".
+ *
+ * Protocol (QEMU's state machine, kept bit for bit):
+ *   - port 0x304 (cmd): a command byte, then read back = the status byte
+ *   - port 0x300 (data): the four key characters, then the data bytes, and
+ *     on read the data bytes
+ *   - port 0x31E (err): the error code of the last command (read only)
+ * Only READ (0x10) is implemented, as in QEMU 8.2: everything else answers
+ * status 0x08 with error 0x82, and macOS tolerates it (it then reads the
+ * values it needs by key, which is the "old SMC mode").
+ *
+ * The machine describes it in its ACPI tables as QEMU's q35 does not
+ * (src/acpi_tables.js, Device(SMC) _HID "APP0001", I/O 0x300-0x31F and IRQ 6):
+ * AppleSMC.kext matches that device, so kextd loads it from /S/L/E.
+ */
+
+/** The key Dont_Steal_Mac_OS_X expects, 64 characters: OSK0 then OSK1 (QEMU's -osk default) */
+export const APPLESMC_DEFAULT_OSK =
+    "ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc";
+
+/** Where the ACPI tables put it (src/acpi_tables.js): 0x20 bytes, IRQ 6 */
+export const SMC_DATA_PORT = 0x300;
+export const SMC_CMD_PORT = 0x304;
+export const SMC_ERR_PORT = 0x31E;
+
+const APPLESMC_READ_CMD = 0x10;
+
+const ST_CMD_DONE = 0x00;
+const ST_DATA_READY = 0x01;
+const ST_BUSY = 0x02;
+const ST_ACK = 0x04;
+const ST_NEW_CMD = 0x08;
+
+const ST_1E_CMD_INTRUPTED = 0x80;
+const ST_1E_STILL_BAD_CMD = 0x81;
+const ST_1E_BAD_CMD = 0x82;
+const ST_1E_NOEXIST = 0x84;
+const ST_1E_WRITEONLY = 0x85;
+const ST_1E_READONLY = 0x86;
+const ST_1E_BAD_INDEX = 0xB8;
+
+/**
+ * @constructor
+ * @param {CPU} cpu
+ * @param {string=} osk 64 characters, OSK0 then OSK1 (tests; macOS needs the default)
+ */
+export function SMC(cpu, osk)
+{
+    /** @const @type {CPU} */
+    this.cpu = cpu;
+
+    this.osk = osk && osk.length === 64 ? osk : APPLESMC_DEFAULT_OSK;
+
+    /** @type {!Object<string, !Uint8Array>} */
+    this.keys = Object.create(null);
+    // (QEMU's applesmc_add_ioport keys: REV, the 64 OSK characters, NATJ's
+    // number of available messages, and the machine's serial numbers, which
+    // macOS only reads when it finds them; empty values are enough)
+    this.add_key("REV ", [0x01, 0x13, 0x0F, 0x00, 0x00, 0x03]);
+    this.add_key("OSK0", this.osk.slice(0, 32));
+    this.add_key("OSK1", this.osk.slice(32, 64));
+    this.add_key("NATJ", [0x00]);
+    this.add_key("MSSP", [0x00]);
+    this.add_key("MSSD", [0x00]);
+
+    this.cmd = 0;
+    this.status = 0;
+    this.status_1e = 0;
+    this.last_ret = 0;
+
+    // the four characters of the key of the READ command in progress
+    this.key = new Uint8Array(4);
+    this.read_pos = 0;
+
+    this.data = new Uint8Array(255);
+    this.data_len = 0;
+    this.data_pos = 0;
+
+    cpu.io.register_read(SMC_DATA_PORT, this, this.data_read, this.data_read16, this.data_read32);
+    cpu.io.register_write(SMC_DATA_PORT, this, this.data_write, this.data_write16, this.data_write32);
+    cpu.io.register_read(SMC_CMD_PORT, this, this.cmd_read, this.cmd_read16, this.cmd_read32);
+    cpu.io.register_write(SMC_CMD_PORT, this, this.cmd_write, this.cmd_write16);
+    cpu.io.register_read(SMC_ERR_PORT, this, this.err_read);
+    cpu.io.register_write(SMC_ERR_PORT, this, this.err_write);
+}
+
+/**
+ * @param {string} key four characters
+ * @param {!Array<number>|string} data
+ */
+SMC.prototype.add_key = function(key, data)
+{
+    this.keys[key] = typeof data === "string" ?
+        Uint8Array.from(data, c => c.charCodeAt(0) & 0xFF) :
+        Uint8Array.from(data);
+};
+
+/** @return {string} the four characters of the key being read */
+SMC.prototype.key_name = function()
+{
+    return String.fromCharCode(this.key[0], this.key[1], this.key[2], this.key[3]);
+};
+
+/**
+ * The command register: 0x304 written, 0x304 read for the status.
+ * @param {number} value
+ */
+SMC.prototype.cmd_write = function(value)
+{
+    const status = this.status & 0x0F;
+
+    if(value === APPLESMC_READ_CMD)
+    {
+        if(status === ST_CMD_DONE || status === ST_NEW_CMD)
+        {
+            this.cmd = value;
+            this.status = ST_NEW_CMD | ST_ACK;
+        }
+        else
+        {
+            // (a command the guest left half-done: QEMU reports it, macOS retries)
+            this.status = ST_NEW_CMD;
+            this.status_1e = ST_1E_CMD_INTRUPTED;
+        }
+    }
+    else
+    {
+        // WRITE (0x11), GET_KEY_BY_INDEX (0x12) and GET_KEY_TYPE (0x13) are
+        // not QEMU's either: the SMC says so, and macOS falls back to READ
+        this.status = ST_NEW_CMD;
+        this.status_1e = ST_1E_BAD_CMD;
+    }
+
+    this.read_pos = 0;
+    this.data_pos = 0;
+};
+
+/**
+ * The data register, written: the four key characters, then the DATA_READY
+ * byte whose value is the length of the answer.
+ * @param {number} value
+ */
+SMC.prototype.data_write = function(value)
+{
+    if(this.cmd !== APPLESMC_READ_CMD)
+    {
+        this.status = ST_CMD_DONE;
+        this.status_1e = ST_1E_STILL_BAD_CMD;
+        return;
+    }
+
+    if((this.status & 0x0F) === ST_CMD_DONE)
+    {
+        // (a stray write after the transfer ended: ignored, as in QEMU)
+        return;
+    }
+
+    if(this.read_pos < 4)
+    {
+        this.key[this.read_pos] = value;
+        this.status = ST_ACK;
+    }
+    else if(this.read_pos === 4)
+    {
+        const name = this.key_name();
+        const data = this.keys[name];
+
+        if(data)
+        {
+            this.data.set(data);
+            this.data_len = data.length;
+            this.data_pos = 0;
+            this.status = ST_ACK | ST_DATA_READY;
+            this.status_1e = ST_CMD_DONE;
+        }
+        else
+        {
+            this.status = ST_CMD_DONE;
+            this.status_1e = ST_1E_NOEXIST;
+        }
+    }
+
+    this.read_pos++;
+};
+
+/** @return {number} the next data byte, and the last one given once the answer is out */
+SMC.prototype.data_read = function()
+{
+    if(this.cmd !== APPLESMC_READ_CMD)
+    {
+        this.status = ST_CMD_DONE;
+        this.status_1e = ST_1E_STILL_BAD_CMD;
+        return this.last_ret;
+    }
+
+    if(!(this.status & ST_DATA_READY))
+    {
+        // (before DATA_READY, QEMU returns the last byte read: ports are not latched)
+        return this.last_ret;
+    }
+
+    if(this.data_pos < this.data_len)
+    {
+        this.last_ret = this.data[this.data_pos];
+        this.data_pos++;
+
+        if(this.data_pos === this.data_len)
+        {
+            this.status = ST_CMD_DONE;
+        }
+        else
+        {
+            this.status = ST_ACK | ST_DATA_READY;
+        }
+    }
+
+    return this.last_ret;
+};
+
+/**
+ * Wide accesses: QEMU's SMC memory region is 8-bit only (min/max access size
+ * 1), so a 16- or 32-bit access is a sequence of byte accesses. v86 hands the
+ * whole word to the port's read16/read32 instead, so the device splits it.
+ * @return {number}
+ */
+SMC.prototype.data_read16 = function()
+{
+    const lo = this.data_read();
+    const hi = this.data_read();
+    return lo | hi << 8;
+};
+
+/** @return {number} */
+SMC.prototype.data_read32 = function()
+{
+    return (this.data_read() | this.data_read() << 8 | this.data_read() << 16 | this.data_read() << 24) >>> 0;
+};
+
+/** @param {number} value */
+SMC.prototype.data_write16 = function(value)
+{
+    this.data_write(value & 0xFF);
+    this.data_write(value >> 8 & 0xFF);
+};
+
+/** @param {number} value */
+SMC.prototype.data_write32 = function(value)
+{
+    this.data_write(value & 0xFF);
