+/// IRQ 0 -> GSI 2 interrupt source override tells the guest.
+fn gsi_input(i: u8) -> u8 { if i == 0 { 2 } else { i } }
+
 fn set_irq_internal(ioapic: &mut Ioapic, i: u8) {
