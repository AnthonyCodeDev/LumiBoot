index 00000000..0aa19c55
--- /dev/null
+++ b/src/usb/hid_keyboard.js
@@ -0,0 +1,257 @@
+// A USB HID boot keyboard: six keys held plus the eight modifiers, a
+// full-speed device with one interrupt IN endpoint (as QEMU's usb-kbd; HID
+// 1.11, appendix B.1). A guest with no PS/2 controller or driver (macOS on a
+// Mac) takes this one: IOUSBHIDDriver and AppleHIDKeyboard bind to the boot
+// interface. Reports go out when something changed, or after the idle time
+// SET_IDLE asks for; otherwise the endpoint NAKs.
+//
+// Added for the Lion campaign (v64): Lion 10.7.5 ships no PS/2 driver at
+// all, so the keyboard has to be a USB one.
+
+import { USBDevice } from "./usb_device.js";
+import {
+    DESCRIPTOR_HID, DESCRIPTOR_REPORT, ENDPOINT_INTERRUPT, SPEED_FULL, USB_NAK, USB_STALL,
+    configuration_descriptor, device_descriptor, endpoint_descriptor, interface_descriptor,
+} from "./usb.js";
+
+/** The report: modifiers, a reserved byte, six key usages (boot keyboard) */
+const REPORT_DESCRIPTOR = [
+    0x05, 0x01, // Usage Page (Generic Desktop)
+    0x09, 0x06, // Usage (Keyboard)
+    0xA1, 0x01, // Collection (Application)
+    0x05, 0x07, //   Usage Page (Keyboard)
+    0x19, 0xE0, //   Usage Minimum (Left Control)
+    0x29, 0xE7, //   Usage Maximum (Right GUI)
+    0x15, 0x00, //   Logical Minimum (0)
+    0x25, 0x01, //   Logical Maximum (1)
+    0x75, 0x01, //   Report Size (1)
+    0x95, 0x08, //   Report Count (8)
+    0x81, 0x02, //   Input (Data, Variable, Absolute): the modifiers
+    0x95, 0x01, //   Report Count (1)
+    0x75, 0x08, //   Report Size (8)
+    0x81, 0x01, //   Input (Constant): the reserved byte
+    0x95, 0x05, //   Report Count (5)
+    0x75, 0x01, //   Report Size (1)
+    0x05, 0x08, //   Usage Page (LEDs)
+    0x19, 0x01, //   Usage Minimum (Num Lock)
+    0x29, 0x05, //   Usage Maximum (Kana)
+    0x91, 0x02, //   Output (Data, Variable, Absolute): the LEDs
+    0x95, 0x01, //   Report Count (1)
+    0x75, 0x03, //   Report Size (3)
+    0x91, 0x01, //   Output (Constant): the LEDs' padding
+    0x95, 0x06, //   Report Count (6)
+    0x75, 0x08, //   Report Size (8)
+    0x15, 0x00, //   Logical Minimum (0)
+    0x25, 0x65, //   Logical Maximum (101)
+    0x05, 0x07, //   Usage Page (Keyboard)
+    0x19, 0x00, //   Usage Minimum (0)
+    0x29, 0x65, //   Usage Maximum (101)
+    0x81, 0x00, //   Input (Data, Array): the key usages
+    0xC0,       // End Collection
+];
+const REPORT_SIZE = 8;
+const MAX_KEYS = 6;
+const MAX_PENDING = 64;
+
+const HID_DESCRIPTOR = [9, DESCRIPTOR_HID, 0x11, 0x01, 0x00, 0x01, DESCRIPTOR_REPORT, REPORT_DESCRIPTOR.length & 0xFF, REPORT_DESCRIPTOR.length >> 8];
+
+// HID class requests
+const HID_GET_REPORT = 0x01, HID_GET_IDLE = 0x02, HID_GET_PROTOCOL = 0x03, HID_SET_REPORT = 0x09, HID_SET_IDLE = 0x0A,
+    HID_SET_PROTOCOL = 0x0B;
+
+/**
+ * @constructor
+ * @extends {USBDevice}
+ * @param {function():number} now the machine clock (milliseconds), for the idle rate
+ */
+export function HIDKeyboard(now)
+{
+    this.now = now;
+    /** @type {?function(boolean)} whether the guest has the keyboard configured, when that changes */
+    this.on_use = null;
+    this.in_use = false;
+    USBDevice.call(this, {
+        name: "keyboard",
+        speeds: [SPEED_FULL],
+        device: device_descriptor({ usb: 0x0110, class: 0, subclass: 0, protocol: 0, max_packet0: 8,
+            // (QEMU's keyboard's IDs, which drivers know)
+            vendor: 0x0627, product: 0x0001, release: 0x0000, manufacturer: 1, product_string: 2, serial: 3, configurations: 1 }),
+        configurations: [configuration_descriptor({ value: 1, attributes: 0x80, max_power: 50, interfaces: 1 }, [
+            // (the boot interface: subclass 1, protocol 1, as QEMU's)
+            interface_descriptor({ number: 0, alternate: 0, endpoints: 1, class: 3, subclass: 1, protocol: 1 }),
+            HID_DESCRIPTOR,
+            endpoint_descriptor({ address: 0x81, type: ENDPOINT_INTERRUPT, max_packet: 8, interval: 10 }),
+        ])],
+        strings: ["v86", "v86 USB Keyboard", "1"],
+        endpoints: [0x81],
+    });
+    /** the modifiers the guest has been told are held: bits 0 to 7 for usages 0xE0 to 0xE7 */
+    this.modifiers = 0;
+    /** the keys the guest has been told are held, as HID usages (0x04 to 0x65), in the order they went down */
+    this.keys = [];
+    /** the LEDs the guest asked for (the output report) */
+    this.leds = 0;
+    /**
+     * The key transitions not delivered yet, oldest first: a report carries
+     * one transition, so a keystroke is never lost to a guest that polls
+     * slower than the page types (a down and its up coalesced into nothing)
+     * @type {!Array<{usage: number, down: boolean}>}
+     */
+    this.pending = [];
+    /** something to report */
+    this.changed = false;
+    this.last_report = 0;
+}
+
+HIDKeyboard.prototype = Object.create(USBDevice.prototype);
+
+HIDKeyboard.prototype.reset = function()
+{
+    USBDevice.prototype.reset.call(this);
+    /** SET_IDLE: in 4 ms units, 0 only on change */
+    this.idle = 0;
+    this.protocol = 1;
+    // (a bus reset lets the guest's view go: no key stays down)
+    this.modifiers = 0;
+    this.keys = [];
+    this.leds = 0;
+    this.pending = [];
+    this.changed = true;
+    this.update_use();
+};
+
+/** Tell on_use whether the guest has the keyboard configured */
+HIDKeyboard.prototype.update_use = function()
+{
+    const in_use = this.configuration !== 0;
+    if(in_use === this.in_use) return;
+    this.in_use = in_use;
+    if(this.on_use) this.on_use(in_use);
+};
+
+/**
+ * A key went down or up
+ * @param {number} usage the HID usage (0x04 to 0x65, 0xE0 to 0xE7 the modifiers)
+ * @param {boolean} down
+ */
+HIDKeyboard.prototype.key = function(usage, down)
+{
+    usage = usage | 0;
+    const modifier = usage >= 0xE0 && usage <= 0xE7;
+    if(!modifier && (usage < 0x04 || usage > 0x65)) return;
+    // (a page that got ahead of a dead guest cannot make it grow without end)
+    if(this.pending.length >= MAX_PENDING) return;
+    this.pending.push({ "usage": usage, "down": !!down });
+    this.changed = true;
+};
+
+/**
+ * The oldest transition not delivered yet, applied to the guest's view
+ * @return {boolean} whether there was one
+ */
+HIDKeyboard.prototype.apply_pending = function()
+{
+    const transition = this.pending.shift();
+    if(!transition) return false;
+    const usage = transition.usage, down = transition.down;
+    if(usage >= 0xE0 && usage <= 0xE7)
+    {
+        const bit = 1 << (usage - 0xE0);
+        this.modifiers = down ? this.modifiers | bit : this.modifiers & ~bit;
+        return true;
+    }
+    const at = this.keys.indexOf(usage);
+    if(down)
+    {
+        // (already held, or dropped: the report has room for six)
+        if(at === -1 && this.keys.length < MAX_KEYS) this.keys.push(usage);
+    }
+    else if(at !== -1)
+    {
+        this.keys.splice(at, 1);
+    }
+    return true;
+};
+
+/** @return {!Uint8Array} the report of what the guest has been told */
+HIDKeyboard.prototype.report = function()
+{
+    const report = new Uint8Array(REPORT_SIZE);
+    report[0] = this.modifiers;
+    for(let i = 0; i < this.keys.length; i++) report[2 + i] = this.keys[i];
+    return report;
+};
+
+HIDKeyboard.prototype.data_in = function(endpoint, max_length)
+{
+    const now = this.now();
+    // (one transition per report: down, then up, even if the guest lags)
+    if(this.pending.length || this.changed) this.apply_pending();
+    else if(!(this.idle && now - this.last_report >= this.idle * 4)) return USB_NAK;
+    const report = this.report();
+    this.changed = this.pending.length !== 0;
+    this.last_report = now;
+    return report.subarray(0, Math.min(max_length, REPORT_SIZE));
+};
+
+HIDKeyboard.prototype.interface_descriptor = function(type, index, interface_number)
+{
+    if(interface_number !== 0) return null;
+    if(type === DESCRIPTOR_HID) return HID_DESCRIPTOR;
+    if(type === DESCRIPTOR_REPORT) return REPORT_DESCRIPTOR;
+    return null;
+};
+
+HIDKeyboard.prototype.class_request = function(setup, data)
+{
+    // (requests to the interface)
+    if((setup.type & 0x1F) !== 1 || (setup.index & 0xFF) !== 0) return USB_STALL;
+    switch(setup.request)
+    {
+        case HID_GET_REPORT:
+            return (setup.value >> 8) === 1 ? this.report() : new Uint8Array(REPORT_SIZE);
+        case HID_SET_REPORT:
+            // (the LEDs: the guest's output report, accepted and kept)
+            if(data && data.length) this.leds = data[0];
+            return new Uint8Array(0);
+        case HID_GET_IDLE:
+            return Uint8Array.of(this.idle);
+        case HID_SET_IDLE:
+            this.idle = setup.value >> 8;
+            return new Uint8Array(0);
+        case HID_GET_PROTOCOL:
+            return Uint8Array.of(this.protocol);
+        case HID_SET_PROTOCOL:
+            this.protocol = setup.value & 1;
+            return new Uint8Array(0);
+    }
+    return USB_STALL;
+};
+
+HIDKeyboard.prototype.configured = function(value)
+{
+    // (the guest's driver takes a fresh report)
+    this.changed = true;
+    this.update_use();
+};
+
+HIDKeyboard.prototype.get_state = function()
+{
+    return [USBDevice.prototype.get_state.call(this), this.modifiers, this.keys.slice(), this.leds, +this.changed,
+        this.idle, this.protocol, this.pending.map(transition => [transition.usage, +transition.down])];
+};
+
+HIDKeyboard.prototype.set_state = function(state)
+{
+    USBDevice.prototype.set_state.call(this, state[0]);
+    this.modifiers = state[1];
+    this.keys = state[2].slice();
+    this.leds = state[3];
+    this.changed = !!state[4];
+    this.idle = state[5];
+    this.protocol = state[6];
+    this.pending = (state[7] || []).map(transition => ({ "usage": transition[0], "down": !!transition[1] }));
+    this.last_report = this.now();
+    this.in_use = !this.configuration;
+    this.update_use();
+};
