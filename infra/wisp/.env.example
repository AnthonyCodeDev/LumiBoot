# Sous-domaine DNS pointant vers l'adresse IP publique de ce serveur Linux.
WISP_DOMAIN=relay.example.com

# Origine exacte de LumiBoot (schema + domaine + port eventuel, sans slash final).
# Exemple en production : https://lumiboot.example.com
# Exemple en developpement : http://localhost:5173
LUMIBOOT_ORIGIN=https://lumiboot.example.com
