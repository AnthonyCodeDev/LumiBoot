# DNS subdomain of the relay.
WISP_DOMAIN=relay.example.com

# Exact LumiBoot origin, without a trailing slash.
LUMIBOOT_ORIGIN=https://lumiboot.example.com

# Host interface Caddy publishes 80/443 on. Loopback by default: the relay has
# no authentication of its own and would otherwise be an open TCP proxy on the
# server's network. Set 0.0.0.0 to expose it, and only behind an authenticating,
# egress-filtered front end (see README.md).
# WISP_BIND_ADDRESS=127.0.0.1
