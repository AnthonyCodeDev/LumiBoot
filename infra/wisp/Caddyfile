{$WISP_DOMAIN} {
    # Caddy HTTPS/TLS probe, not the WISP backend.
    handle /healthz {
        respond "ok" 200
    }

    # `Origin` is not authentication: a non-browser client can forge it.
    @allowed {
        header Origin {$LUMIBOOT_ORIGIN}
        header Upgrade websocket
    }
    handle @allowed {
        reverse_proxy wisp:8080
    }

    handle {
        respond "Forbidden" 403
    }
}
