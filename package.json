{
  "name": "lumiboot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LumiBoot: a library and launcher for operating systems in the browser",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Anthony (AnthonyCodeDev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnthonyCodeDev/LumiBoot.git"
  },
  "homepage": "https://github.com/AnthonyCodeDev/LumiBoot#readme",
  "bugs": {
    "url": "https://github.com/AnthonyCodeDev/LumiBoot/issues"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lumiboot/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @lumiboot/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "assets:prepare": "node scripts/prepare-v86-assets.mjs",
    "assets:check": "node scripts/prepare-v86-assets.mjs --check",
    "assets:v64:prepare": "node scripts/prepare-v64-assets.mjs",
    "assets:v64:check": "node scripts/prepare-v64-assets.mjs --check",
    "assets:v64:alpine": "node scripts/prepare-v64-alpine.mjs",
    "assets:windows7:prepare": "node scripts/prepare-windows7-asset.mjs",
    "assets:windows7:check": "node scripts/prepare-windows7-asset.mjs --check",
    "assets:windows7:serve": "node scripts/serve-windows7-asset.mjs",
    "assets:windows10:prepare": "node scripts/prepare-windows10-asset.mjs",
    "assets:windows10:check": "node scripts/prepare-windows10-asset.mjs --check",
    "config:nginx": "node scripts/render-nginx-config.mjs",
    "config:nginx:check": "node scripts/render-nginx-config.mjs --check",
    "proxy:dev": "node scripts/run-network-proxy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  }
}
