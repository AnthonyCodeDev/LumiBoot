[Unit]
Description=LumiBoot desktop readiness marker (Xorg + Openbox)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The marker is only emitted once the X server and the session really run; a
# distinct failure marker is written otherwise.
# Generous start timeout: the software emulation of v86 is slow.
TimeoutStartSec=360
ExecStart=/usr/local/bin/lumiboot-desktop-ready

[Install]
WantedBy=multi-user.target
