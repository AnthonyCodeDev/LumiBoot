# LumiBoot: prepare the disposable account before OpenRC starts any service, so
# udev and dbus run with the users and groups they expect.
::sysinit:/usr/local/sbin/lumiboot-setup
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# tty1 starts the XFCE session: the login shell reads /home/lumiboot/.profile,
# which execs lumiboot-startx. ttyS0 keeps a text shell for the smoke test while
# the desktop runs. Both use the autologin helper, which only prints its VGA
# marker on tty0/tty1.
tty1::respawn:/sbin/getty -n -l /usr/local/sbin/lumiboot-autologin -L 0 tty1 linux
ttyS0::respawn:/sbin/getty -n -l /usr/local/sbin/lumiboot-autologin -L 115200 ttyS0 vt100

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
