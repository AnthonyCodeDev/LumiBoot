[Unit]
Description=LumiBoot desktop readiness marker (Xorg + Openbox)
# Marquage émis seulement APRÈS le démarrage effectif du serveur X et de la
# session graphique (voir /usr/local/bin/lumiboot-desktop-ready). Jamais simulé.
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Sonde réelle : attend que le serveur X réponde sur :0 et qu'Openbox tourne,
# puis écrit LUMIBOOT_DESKTOP_READY sur ttyS0. Tant que ce n'est pas vrai, le
# marqueur n'est PAS émis (échec signalé par un marqueur distinct).
ExecStart=/usr/local/bin/lumiboot-desktop-ready

[Install]
WantedBy=multi-user.target
