[Unit]
Description=LumiBoot desktop readiness marker (Xorg + Openbox)
# Marker only emitted AFTER the X server and the graphical session have actually
# started (see /usr/local/bin/lumiboot-desktop-ready). Never simulated.
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Real probe: waits for the X server to answer on :0 and for Openbox to run,
# then writes LUMIBOOT_DESKTOP_READY to ttyS0. As long as this is not true, the
# marker is NOT emitted (failure signalled by a distinct marker).
# Generous start timeout: the software emulation of v86 is slow.
TimeoutStartSec=360
ExecStart=/usr/local/bin/lumiboot-desktop-ready

[Install]
WantedBy=multi-user.target
