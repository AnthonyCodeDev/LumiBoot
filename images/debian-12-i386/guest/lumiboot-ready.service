[Unit]
Description=LumiBoot guest boot readiness marker
After=systemd-user-sessions.service
Wants=systemd-user-sessions.service

[Service]
Type=oneshot
# Emitted by the guest system once multi-user is reached, never by the client.
ExecStart=/bin/sh -c 'printf "LUMIBOOT_GUEST_READY:debian-12-i386\n" > /dev/ttyS0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
