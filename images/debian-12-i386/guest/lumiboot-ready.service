[Unit]
Description=LumiBoot guest boot readiness marker
# Only emitted when the multi-user system is reached.
After=systemd-user-sessions.service
Wants=systemd-user-sessions.service

[Service]
Type=oneshot
# The marker comes from the real guest system, never from JavaScript.
ExecStart=/bin/sh -c 'printf "LUMIBOOT_GUEST_READY:debian-12-i386\n" > /dev/ttyS0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
