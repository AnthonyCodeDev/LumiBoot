# Normalise line endings: LF in the repository, on every platform.
* text=auto eol=lf

# Shell scripts, Go and service units must keep LF: CRLF breaks them.
*.sh text eol=lf
*.go text eol=lf
*.conf text eol=lf
*.service text eol=lf

# Text assets kept as text so diffs stay readable.
*.svg text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binaries: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.tar.gz binary
*.zip binary
*.img binary
*.iso binary
*.qcow2 binary
*.vhd binary
*.vhdx binary
*.vmdk binary
*.vdi binary
*.wasm binary
*.bin binary

# Generated: no review value in diffs or language statistics.
pnpm-lock.yaml linguist-generated=true -diff
