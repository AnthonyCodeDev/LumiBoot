# LumiBoot — variables d'environnement (exemple)
# Copier vers un fichier local .env.* et adapter si nécessaire.
# Ne jamais committer de secrets ni d'identifiants réels.

# Frontend / variables publiques uniquement
VITE_CATALOG_SOURCE=local
# VITE_DEBUG=false

# Préparation du disque Windows 7 (scripts/prepare-windows7-asset.mjs).
# Par défaut, l'image est lue à images/windows-7-pro-sp1-x86/disk.img (racine du
# dépôt, ignorée par Git). Décommenter pour pointer un chemin absolu (serveur).
# WINDOWS7_IMG=C:\chemin\vers\Windows7Pro.img

# Préparation du disque Windows 10 (scripts/prepare-windows10-asset.mjs).
# Par défaut, l'image est lue à images/windows-10-x86/disk.img (racine du dépôt,
# ignorée par Git). Décommenter pour pointer un chemin absolu (serveur).
# WINDOWS10_IMG=C:\chemin\vers\Windows10-32bit.img
