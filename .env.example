# LumiBoot — variables d'environnement (exemple)
# Copier vers .env et adapter. Ne jamais committer de secrets.

# Frontend (préfixe VITE_ = PUBLIC, exposé au navigateur)
VITE_API_BASE_URL=http://localhost:8787
VITE_CATALOG_SOURCE=local

# Backend distant (Lot 4 uniquement) — NE PAS activer pour le MVP local
# API_PORT=8787
# DATABASE_URL=postgres://lumiboot:lumiboot@localhost:5432/lumiboot
# SESSION_TTL_MINUTES=45
