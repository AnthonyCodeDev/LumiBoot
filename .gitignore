# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Caches
.cache/
.eslintcache
.tmp/
tmp/

# Tests and coverage
playwright-report/
test-results/

# Logs
*.log
*.log.*
npm-debug.log*
pnpm-debug.log*

# VM disks and images
*.img
*.iso
*.qcow2
*.vhd
*.vhdx
*.vmdk
*.vdi

# Images: manifests and scripts are tracked, provenance stays local
/images/*/provenance.txt

*.dmg
*.pkg
*.pkg/
/images/macos-lion-x64/build/
# macOS Lion: proof captures of an operator-side Apple session stay local
/images/macos-lion-x64/bureau-lumiboot-*.png

# Network client release binaries (published as GitHub Release assets, never committed)
/apps/web/public/downloads/*.exe
/apps/web/public/downloads/*.tar.gz
/apps/web/public/downloads/*.zip
/apps/web/public/downloads/*.msi
/apps/web/public/downloads/*.pkg
!/apps/web/public/downloads/manifest.json
!/apps/web/public/downloads/SHA256SUMS

# IDE
.vscode/*
!.vscode/extensions.json

# System
.DS_Store
Thumbs.db

# Local archives
*.bak
*.old
*.orig

# Secrets: only examples are tracked, including nested ones
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# v86 binaries and disks prepared outside the repo
/apps/web/public/v86/
/apps/web/public/v64/
/apps/web/public/images/
