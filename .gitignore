
# ==========================================
# LumiBoot - Git Ignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Build outputs
dist/
build/
out/
.output/
.next/
.nuxt/
.svelte-kit/
.angular/
storybook-static/
*.tsbuildinfo

# Caches
.cache/
.turbo/
.vite/
.parcel-cache/
.eslintcache
.stylelintcache
.rspack-cache/
.temp/
.tmp/
tmp/
temp/

# Test results and coverage
coverage/
.nyc_output/
.vitest/
playwright-report/
test-results/
blob-report/
junit.xml

# Logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Disk images and virtual machines
*.img
*.iso
*.qcow
*.qcow2
*.vhd
*.vhdx
*.vmdk
*.vdi
*.ext2
*.ext3
*.ext4

# Large generated binary artifacts
*.dump
*.core
*.pid
*.part

# Images : la CONFIG est versionnée, les BINAIRES ne le sont pas.
# - manifestes génériques (aucun chemin absolu), README et scripts d'image : versionnés ;
# - disques et médias (*.img/*.iso, cf. plus haut), sorties de build et
#   provenance.txt (taille/mtime/SHA-256 propres à la machine) : jamais versionnés.
/images/*/disk.img
*/images/*/disk.img
/images/*/build*/
/images/*/provenance.txt
/media/

# IDE and editors
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~

# Operating system
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Deployment artifacts
.vercel/
.netlify/

# Generated project reports
architecture.txt
architecture-clean.txt

# Local archives and backups
LumiBoot-source.zip
*.bak
*.backup
*.old
*.orig

# Keep placeholder files
!*.keep

# ==========================================
# Environment files
# Ignorer tous les secrets, y compris dans les sous-dossiers.
# Seuls les exemples sont versionnés.
# ==========================================
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# ==========================================
# Config locale des agents IA (jamais publiée)
# AGENTS.md et opencode.jsonc contiennent les prompts, agents et modèles
# locaux : propres à la machine, ils restent sur le disque et ne sont
# jamais versionnés ni publiés sur GitHub.
# ==========================================
/AGENTS.md
/opencode.jsonc
/opencode.json
/.opencode/

# ==========================================
# v86 engine binaries and system disk images
# Prepared by scripts/prepare-v86-assets.mjs and images/*/build.sh.
# Served at runtime, obtained from approved storage in CI/CD — never committed.
# ==========================================
/apps/web/public/v86/
/apps/web/public/images/
